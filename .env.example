# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=BankTech-Analytics
ENVIRONMENT=development
PORT=8000

# IMPORTANT: generate a real secret before any deployment
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-secret-key-here>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@localhost:5432/<db-name>

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL the frontend uses to reach the API (production only; dev uses Vite proxy)
VITE_API_URL=http://localhost:8000

# ── Phase 2+ LLM / RAG (leave blank until Phase 2) ──────────────────────────
OPENAI_API_KEY=<your-openai-api-key-here>
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
